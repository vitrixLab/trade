{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/event.schema.json",
  "title": "Financial intelligence event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "title",
    "category",
    "region",
    "event_at",
    "status",
    "summary",
    "source",
    "quality"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "event_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "monetary_policy",
        "inflation",
        "growth",
        "employment",
        "fiscal",
        "geopolitical",
        "trade",
        "commodity",
        "corporate",
        "regulatory",
        "market_structure",
        "other"
      ]
    },
    "region": { "type": "string", "minLength": 2 },
    "event_at": { "type": ["string", "null"], "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "status": {
      "enum": ["scheduled", "reported", "confirmed", "cancelled", "rumor_unverified"]
    },
    "summary": { "type": "string" },
    "market_channels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "impact_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["positive", "negative", "mixed", "unclear"] },
        "horizon": {
          "enum": ["intraday", "short_term", "medium_term", "long_term", "unknown"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string" }
      }
    },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "quality": { "$ref": "common.schema.json#/$defs/quality" }
  }
}
